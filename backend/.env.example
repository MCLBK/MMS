# Database
DATABASE_URL=postgresql+asyncpg://mms_user:mms_password@localhost:5432/mms_express

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=MMS Express
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# First super admin (created on first run)
FIRST_ADMIN_EMAIL=admin@mmsexpress.com
FIRST_ADMIN_PASSWORD=Admin123!

# AI / Ollama (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# GPS
GPS_UPDATE_INTERVAL_SECONDS=10
GPS_MAX_HISTORY_DAYS=30
