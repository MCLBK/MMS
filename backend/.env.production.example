# Database
DATABASE_URL=postgresql+asyncpg://mms_user:${POSTGRES_PASSWORD}@postgres:5432/mms_express

# Redis
REDIS_URL=redis://redis:6379/0

# Security — CHANGE THIS IN PRODUCTION
SECRET_KEY=GENERATE-A-RANDOM-64-CHAR-KEY-HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=3

# App
APP_NAME=MMS Express
APP_ENV=production
DEBUG=false
CORS_ORIGINS=https://your-domain.com

# First super admin
FIRST_ADMIN_EMAIL=admin@mmsexpress.com
FIRST_ADMIN_PASSWORD=CHANGE-THIS-STRONG-PASSWORD

# AI / Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# GPS
GPS_UPDATE_INTERVAL_SECONDS=10
GPS_MAX_HISTORY_DAYS=30
